{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "/transport.js": [
        "frontend/src/api/transport.ts"
      ]
    },
    "incremental": true,
    "tsBuildInfoFile": "./.scratch/check-cache/types/browser.tsbuildinfo"
  },
  "include": [
    "tests/browser/**/*.ts"
  ]
}
