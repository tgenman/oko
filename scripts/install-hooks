#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
current=$(git config --get core.hooksPath || true)
if [ -n "$current" ] && [ "$current" != .githooks ]; then
    echo "Existing core.hooksPath=$current; reconcile existing hooks before installing Oko hooks." >&2
    exit 1
fi
if [ -z "$current" ]; then
    hooks=$(git rev-parse --git-path hooks)
    for hook in "$hooks"/*; do
        case "$hook" in *.sample) continue ;; esac
        if [ -f "$hook" ] && [ -x "$hook" ]; then
            echo "Existing executable hook $hook; reconcile existing hooks before installing Oko hooks." >&2
            exit 1
        fi
    done
fi
git config --local core.hooksPath .githooks
echo 'Oko hooks installed: staged syntax before commit; full checks before push.'
