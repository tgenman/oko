#!/usr/bin/env python3
"""The old file-only local updater is retired; releases include PostgreSQL state."""
import argparse
import sys


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    print('Local file-only updates are retired. Use the verified PostgreSQL release procedure in docs/development/cloud-deploy.md.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
