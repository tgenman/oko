#!/usr/bin/env python3
"""Create an isolated checkout at the fetched origin/main SHA, then cherry-pick explicit commits."""
import argparse
from pathlib import Path
import subprocess
import sys


def git(root, *args):
    return subprocess.check_output(['git', *args], cwd=root, text=True).strip()


def prepare(root, output, commits, branch=None):
    root = Path(git(root, 'rev-parse', '--show-toplevel')).resolve()
    output = output.resolve()
    if output.exists() or output == root or root in output.parents:
        raise ValueError('Output must be a new directory outside the source checkout')
    if branch:
        git(root, 'check-ref-format', '--branch', branch)
    # Resolve source commits before clone: branch names in the clone may differ.
    revisions = [git(root, 'rev-parse', '--verify', commit+'^{commit}') for commit in commits]
    remote = git(root, 'remote', 'get-url', 'origin')
    git(root, 'fetch', 'origin', 'refs/heads/main:refs/remotes/origin/main')
    base = git(root, 'rev-parse', '--verify', 'refs/remotes/origin/main^{commit}')
    git(root, 'clone', '--quiet', '--shared', '--no-checkout', '--', str(root), str(output))
    # A local clone's origin/main tracks the source's LOCAL main. Use the captured SHA.
    git(output, 'checkout', '--quiet', '--detach', base)
    if git(output, 'rev-parse', 'HEAD') != base:
        raise ValueError('Integration checkout does not match fetched main')
    git(output, 'remote', 'set-url', 'origin', remote)
    git(output, 'update-ref', 'refs/remotes/origin/main', base)
    if branch:
        git(output, 'switch', '--quiet', '-c', branch)
    print('Checkout:', output, flush=True)
    print('Base:', base, flush=True)
    for commit in revisions:
        # Conflicts are retained in the isolated checkout for explicit resolution.
        subprocess.run(['git', 'cherry-pick', commit], cwd=output, check=True)
    git(output, 'merge-base', '--is-ancestor', base, 'HEAD')
    print('Head:', git(output, 'rev-parse', 'HEAD'), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--branch')
    parser.add_argument('--commits', nargs='*', default=[])
    args = parser.parse_args()
    try:
        prepare(Path.cwd(), args.output, args.commits, args.branch)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('Integration preparation failed:', error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
