#!/usr/bin/env python3
"""Run checkout checks without installing dependencies or contacting real sources."""
import argparse
import codecs
import hashlib
import stat
import json
import re
import shlex
import select
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
import tempfile
import math
import statistics
import platform
import fcntl
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]


class TimingHistory:
    """Advisory file costs. Invalid/missing data falls back to file sizes."""
    def __init__(self, path, browser_workers):
        self.path = path
        self.context = dict(platform=sys.platform, machine=platform.machine(),
                            cpus=os.cpu_count(), browser_workers=browser_workers)
        self.samples = self.read()

    def read(self):
        try:
            if self.path.is_symlink() or self.path.stat().st_size > 1024 * 1024:
                return {}
            data = json.loads(self.path.read_text())
            if data.get('version') != 1 or data.get('context') != self.context:
                return {}
            return {group: {name: [float(x) for x in values if type(x) in (int,float) and 0 < x <= 86400 and math.isfinite(x)][-3:]
                            for name,values in files.items() if isinstance(name,str) and name.startswith('tests/')
                            and '..' not in Path(name).parts and isinstance(values,list)}
                    for group,files in data.get('suites',{}).items() if group in ('python-tests','tool-tests','browser') and isinstance(files,dict)}
        except (OSError, ValueError, TypeError, AttributeError):
            return {}

    def estimates(self):
        return {group: {name: statistics.median(values) for name,values in files.items() if values}
                for group,files in self.samples.items()}

    def learn(self, report):
        if report.get('exit_code') != 0 or report.get('checkout',{}).get('status') != 'PASS':
            return False
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.path.with_suffix('.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self.read()
            for group in ('python-tests','tool-tests','browser'):
                suite = report.get('suites',{}).get(group,{})
                if not suite.get('status','').startswith('PASS'):continue
                for name,seconds in suite.get('file_durations',{}).items():
                    if not isinstance(name,str) or not name.startswith('tests/') or '..' in Path(name).parts:continue
                    if type(seconds) not in (int,float) or not 0 < seconds <= 86400 or not math.isfinite(seconds):continue
                    samples = data.setdefault(group,{}).setdefault(name,[])
                    samples.append(float(seconds));data[group][name] = samples[-3:]
            pending = self.path.with_name(self.path.name + '.' + uuid4().hex + '.tmp')
            try:
                pending.write_text(json.dumps(dict(version=1,context=self.context,suites=data))+'\n')
                pending.replace(self.path)
            finally:
                pending.unlink(missing_ok=True)
            self.samples = data
        return True


def timing_history_path(root, names):
    groups=[name for name in ('browser','node-tests','python-tests','tool-tests') if name in names]
    return root/'.scratch/check-cache/test-timings'/('-'.join(groups or ['static'])+'.json')


def timed_buckets(files, count, root, hints):
    sizes = {name:max(1,(root / name.split('::')[0]).stat().st_size) for name in files}
    known = {name:hints.get(str((root / name.split('::')[0]).relative_to(root))) for name in files}
    known = {name:value for name,value in known.items() if type(value) in (int,float) and 0 < value <= 86400 and math.isfinite(value)}
    scale = statistics.median(known[name] / sizes[name] for name in known) if known else 1
    costs = {name:max(.001,known.get(name,sizes[name]*scale)) for name in files}
    buckets,loads = [[] for _ in range(count)],[0.0]*count
    for name in sorted(files,key=lambda name:(-costs[name],name)):
        index = min(range(count),key=lambda i:loads[i])
        buckets[index].append(name);loads[index] += costs[name]
    # Keep the established execution order inside balanced groups; avoid
    # synchronizing all process-heavy files at the start of a full run.
    for bucket in buckets:bucket.sort(key=lambda name:(-sizes[name],name))
    return buckets,dict(source='durations' if known else 'file_sizes',known_files=len(known),
                        total_files=len(files),predicted_loads=loads)


class Report:
    def __init__(self, base, names, selected_files):
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        self.directory = base / (stamp + '-' + uuid4().hex[:8])
        self.directory.mkdir(parents=True)
        self.log = (self.directory / 'output.log').open('w', encoding='utf-8')
        self.compact = False
        self.data = dict(started_at=stamp, selected_files=selected_files, checkout=dict(status='PASS', changed_files=[]),
                         suites={name: dict(status='NOT RUN', commands=[], failures=[]) for name in names})
        self.current = None
        self.pending_line = ''
        self.timing_weights = {}
        self.history = None

    def write(self, value):
        self.log.write(value)
        self.log.flush()

    def output(self, value, stream=None):
        self.write(value)
        if not self.compact:
            print(value, end='', file=stream or sys.stdout, flush=True)
        lines = (self.pending_line + value).split('\n')
        self.pending_line = lines.pop()
        for line in lines:
            self.failure(line)

    def failure(self, line):
        if self.current:
            passed = re.match(r'^# pass (\d+)$', line)
            if self.current in ('browser','node-tests'):
                if passed:
                    suite=self.data['suites'][self.current]
                    suite['passed_scenarios']=suite.get('passed_scenarios',0)+int(passed.group(1))
                count=re.match(r'^# (tests|pass|fail|skipped|cancelled) (\d+)$',line)
                if count:
                    key={'tests':'total','pass':'passed','fail':'failed'}.get(count[1],count[1])
                    counts=self.data['suites'][self.current].setdefault('counts',{})
                    counts[key]=counts.get(key,0)+int(count[2])
            match = re.match(r'^(?:FAILED|ERROR) (.+?)(?: - |$)', line)
            tap = re.match(r'^\s*not ok \d+ - (.+)', line)
            failure = match.group(1) if match else tap.group(1).strip() if tap else None
            failures = self.data['suites'][self.current]['failures']
            if failure and failure not in failures:
                failures.append(failure)

    def checkout_changed(self, changed):
        if changed:
            guard = self.data['checkout']
            guard['status'] = 'FAIL'
            guard['changed_files'] = sorted(set(guard['changed_files']) | set(changed))
            self.output('Checkout changed during checks:\n' + ''.join('  ' + name + '\n' for name in changed))

    def flush_line(self):
        self.failure(self.pending_line)
        self.pending_line = ''

    def test_groups(self, results):
        groups={}
        for label, names in [('Python',('python-tests','http')),('tools',('tool-tests',)),
                             ('Node',('node-tests',)),('Playwright',('browser',))]:
            selected=[name for name in names if name in results]
            if not selected:
                continue
            counts={}
            seconds=0.0
            for name in selected:
                suite=self.data['suites'][name]
                seconds+=suite.get('duration_seconds',sum(c.get('duration_seconds',0) for c in suite['commands']))
                for key,value in suite.get('counts',{}).items():
                    counts[key]=counts.get(key,0)+value
            groups[label]=dict(status='PASS' if all(results[n].startswith('PASS') for n in selected) else 'FAIL' if any(results[n].startswith('FAIL') for n in selected) else 'INTERRUPTED' if any(results[n]=='INTERRUPTED' for n in selected) else 'NOT RUN',
                counts=counts,duration_seconds=round(seconds,4))
        self.data['test_groups']=groups
        return groups

    def finish(self, results, exit_code, started):
        for name, status in results.items():
            self.data['suites'][name]['status'] = status
        self.test_groups(results)
        self.data.update(exit_code=exit_code, duration_seconds=round(time.monotonic() - started, 2),
                         log=str(self.directory / 'output.log'))
        if self.history is not None:
            try:self.data['timing_history']['updated'] = self.history.learn(self.data)
            except (OSError,ValueError,TypeError) as error:self.data['timing_history']['error'] = str(error)
        (self.directory / 'report.json').write_text(json.dumps(self.data, ensure_ascii=False, indent=2) + '\n')
        self.log.close()


def descendants(pid):
    # Browsers may start a new process group. Capture descendants before stopping
    # their parent, while their ownership can still be established by PPID.
    table = subprocess.check_output(['ps', '-axo', 'pid=,ppid='], text=True)
    children = [tuple(map(int, line.split())) for line in table.splitlines()]
    owned = {pid}
    while True:
        more = {child for child, parent in children if parent in owned}
        if more <= owned:
            return owned - {pid}
        owned.update(more)


def execute(command, env, report=None, **output):
    record = None
    timing_path = None
    started = time.monotonic()
    if report and report.current == 'browser' and any('run-browser-tests.cts' in part for part in command):
        timing_path = report.directory / ('browser-' + uuid4().hex + '.json')
        position = command.index('--test-reporter=tap') + 1
        command = [*command[:position], '--test-reporter=' + str(ROOT/'scripts/test-timing-reporter.mts'),
                   '--test-reporter-destination=stdout', '--test-reporter-destination=' + str(timing_path), *command[position:]]
        env = dict(env, OKO_TEST_FILE_TIMINGS=json.dumps(report.timing_weights.get('browser',{})))
    if report and report.current and command[1:4] == ['-m', 'pytest', '-q']:
        timing_path = report.directory / ('pytest-' + uuid4().hex + '.xml')
        command = [*command[:4], '--rootdir=' + str(ROOT), '--junitxml=' + str(timing_path), '-o', 'junit_family=xunit1', *command[4:]]
    if report and report.current:
        record = dict(command=[str(part) for part in command], exit_code=None)
        report.data['suites'][report.current]['commands'].append(record)
        report.write('$ ' + shlex.join(record['command']) + '\n')
    if report and not output:
        output = dict(stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    process = subprocess.Popen(command, cwd=ROOT, env=env, start_new_session=True, **output)
    decoder = codecs.getincrementaldecoder('utf-8')(errors='replace')
    eof = False
    def read_output(timeout):
        nonlocal eof
        ready, _, _ = select.select([process.stdout], [], [], timeout)
        if not ready:
            return False
        chunk = os.read(process.stdout.fileno(), 65536)
        if not chunk:
            eof = True
            return False
        report.output(decoder.decode(chunk))
        return True
    def finish_output():
        if report and process.stdout is not None:
            while read_output(0):
                pass
            report.output(decoder.decode(b'', final=True))
            if report.pending_line:
                report.output('\n')
            report.flush_line()
            process.stdout.close()
    try:
        if report and process.stdout is not None:
            while process.poll() is None and not eof:
                read_output(0.1)
        code = process.wait()
        if record is not None:
            record['exit_code'] = code
        return code
    finally:
        try:
            try:
                owned = descendants(process.pid)
            except (OSError, subprocess.SubprocessError):
                # Preserve process-group cleanup even if process inspection fails.
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
                raise
            def stop(sig):
                try:
                    os.killpg(process.pid, sig)
                except ProcessLookupError:
                    pass
                for pid in owned:
                    try:
                        os.kill(pid, sig)
                    except ProcessLookupError:
                        pass
            stop(signal.SIGTERM)
            deadline = time.monotonic() + 1
            while time.monotonic() < deadline:
                process.poll()
                alive = False
                for pid in owned | {process.pid}:
                    try:
                        os.kill(pid, 0)
                        alive = True
                    except ProcessLookupError:
                        pass
                if not alive:
                    break
                time.sleep(0.02)
            stop(signal.SIGKILL)
            process.wait()
        finally:
            finish_output()
            if record is not None:
                record['duration_seconds'] = round(time.monotonic() - started, 4)
            if timing_path and timing_path.suffix == '.json' and timing_path.is_file():
                suite=report.data['suites'][report.current]
                try:
                    data=json.loads(timing_path.read_text())
                    if data.get('version')!=1:raise ValueError('Unknown browser timing format')
                    for name,seconds in data['files'].items():
                        try:relative=Path(name).resolve().relative_to(ROOT).as_posix()
                        except ValueError:continue
                        if relative.startswith('tests/') and type(seconds) in (int,float) and math.isfinite(seconds) and seconds>=0:
                            files=suite.setdefault('file_durations',{});files[relative]=files.get(relative,0)+seconds
                except (OSError,ValueError,TypeError,KeyError,AttributeError) as error:suite['timing_error']=str(error)
            if timing_path and timing_path.suffix == '.xml' and timing_path.is_file():
                suite = report.data['suites'][report.current]
                try:
                    cases=list(ET.parse(timing_path).iter('testcase'))
                    durations = [dict(file=case.get('file', ''), name=case.get('name', ''),
                                      classname=case.get('classname', ''), seconds=float(case.get('time', '0')))
                                 for case in cases]
                    counts=suite.setdefault('counts',{})
                    totals=dict(total=len(cases),failed=sum(c.find('failure') is not None for c in cases),
                        errors=sum(c.find('error') is not None for c in cases),skipped=sum(c.find('skipped') is not None for c in cases))
                    totals['passed']=totals['total']-totals['failed']-totals['errors']-totals['skipped']
                    for key,value in totals.items(): counts[key]=counts.get(key,0)+value
                    suite.setdefault('test_durations', []).extend(durations)
                    files = suite.setdefault('file_durations', {})
                    for case in durations:
                        files[case['file']] = round(files.get(case['file'], 0) + case['seconds'], 4)
                except (OSError, ValueError, ET.ParseError) as error:
                    suite['timing_error'] = str(error)


def syntax_commands(node, paths):
    typed = [str(path) for path in paths if Path(path).suffix in ('.ts', '.tsx', '.cts', '.mts')]
    commands = [[node, '--require', 'tsx/cjs', str(ROOT / 'scripts/check-ts.cts'), *typed]] if typed else []
    return commands + [[node, '--check', str(path)] for path in paths if str(path) not in typed]


def executable(value, name):
    found = shutil.which(value)
    if not found:
        raise RuntimeError(f'{name} missing: {value}. See tests/browser/README.md for setup.')
    return found


def checkout_state(excluded):
    inventory = subprocess.check_output(['git', 'ls-files', '--cached', '--others', '--exclude-standard', '-z'], cwd=ROOT)
    result = {}
    for raw in inventory.split(b'\0'):
        if not raw:
            continue
        name = os.fsdecode(raw)
        path = ROOT / name
        if path.is_relative_to(excluded):
            continue
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            result[name] = None
            continue
        payload = os.fsencode(os.readlink(path)) if stat.S_ISLNK(metadata.st_mode) else path.read_bytes() if stat.S_ISREG(metadata.st_mode) else b''
        result[name] = (metadata.st_mode, hashlib.sha256(payload).hexdigest())
    return result


