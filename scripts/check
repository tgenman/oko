#!/usr/bin/env python3
"""Run checkout checks without installing dependencies or contacting real sources."""
import argparse
import codecs
import hashlib
import stat
import json
import re
import shlex
import select
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
import tempfile
from datetime import datetime, timezone
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]


class Report:
    def __init__(self, base, names, selected_files):
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        self.directory = base / (stamp + '-' + uuid4().hex[:8])
        self.directory.mkdir(parents=True)
        self.log = (self.directory / 'output.log').open('w', encoding='utf-8')
        self.compact = False
        self.data = dict(started_at=stamp, selected_files=selected_files, checkout=dict(status='PASS', changed_files=[]),
                         suites={name: dict(status='NOT RUN', commands=[], failures=[]) for name in names})
        self.current = None
        self.pending_line = ''
        self.events_file = None
        self.tap_failure = None

    def write(self, value):
        self.log.write(value)
        self.log.flush()

    def output(self, value, stream=None):
        self.write(value)
        if not self.compact:
            print(value, end='', file=stream or sys.stdout, flush=True)
        lines = (self.pending_line + value).split('\n')
        self.pending_line = lines.pop()
        for line in lines:
            self.failure(line)

    def failure_event(self, test, reason, file=None):
        suite = self.data['suites'][self.current]
        if test not in suite['failures']:
            suite['failures'].append(test)
        details = suite.setdefault('failure_details', [])
        if any(value['test'] == test for value in details):
            return
        source = Path(json.loads(os.environ.get('OKO_CHECK_SNAPSHOT', '{}')).get('source', str(ROOT)))
        if self.current.startswith(('python-tests', 'tool-tests')):
            retry = [str(source/'scripts/check'), 'python', '--files', test]
        else:
            retry = [str(source/'scripts/check'), 'browser']
            if file:
                path = Path(file)
                if path.is_absolute() and path.is_relative_to(ROOT):
                    file = str(path.relative_to(ROOT))
                retry.extend(['--files', file])
            retry.extend(['--match', '^'+re.escape(test)+'$'])
        event = dict(test=test, reason=reason[:600], log=str(self.directory/'output.log'), retry=shlex.join(retry))
        details.append(event)
        if self.events_file:
            with self.events_file.open('a', encoding='utf-8') as output:
                output.write(json.dumps(event, ensure_ascii=False)+'\n')
        else:
            self.announce_failure(event)

    def announce_failure(self, event):
        message = 'FAIL NOW '+event['test']+': '+event['reason']+'\nLog: '+event['log']+'\nRetry: '+event['retry']+'\n'
        self.write(message)
        print(message, end='', flush=True)

    def failure(self, line):
        if not self.current:
            return
        if line.startswith('OKO_TEST_FAILURE '):
            try:
                event = json.loads(line.removeprefix('OKO_TEST_FAILURE '))
                if isinstance(event['test'], str) and isinstance(event['reason'], str):
                    self.failure_event(event['test'], event['reason'])
                    return
            except (ValueError, KeyError, TypeError):
                pass  # The original output stays in the log even for malformed records.
        passed = re.match(r'^# pass (\d+)$', line)
        if self.current == 'browser' and passed:
            self.data['suites']['browser']['passed_scenarios'] = int(passed.group(1))
        match = re.match(r'^(?:FAILED|ERROR) (.+?)(?: - (.*)|$)', line)
        if match:
            self.failure_event(match.group(1), match.group(2) or 'pytest failed; see full log')
        tap = re.match(r'^\s*not ok \d+ - (.+)', line)
        if tap:
            self.tap_failure = dict(test=tap.group(1).strip(), file=None, multiline=False)
            failure = self.tap_failure['test']
            if failure not in self.data['suites'][self.current]['failures']:
                self.data['suites'][self.current]['failures'].append(failure)
        elif self.tap_failure:
            location = re.match(r"^\s*location: ['\"]?(.+\.[cm]?[jt]sx?):\d+(?::\d+)?", line)
            if location:
                self.tap_failure['file'] = location.group(1)
            reason = re.match(r'^\s*error: (.+)', line)
            if reason:
                value = reason.group(1)
                if value.startswith('|'):
                    self.tap_failure['multiline'] = True
                else:
                    self.failure_event(self.tap_failure['test'], value.strip("'\""), self.tap_failure['file'])
                    self.tap_failure = None
            elif self.tap_failure['multiline'] and line.strip():
                self.failure_event(self.tap_failure['test'], line.strip(), self.tap_failure['file'])
                self.tap_failure = None
            elif line.strip() == '...':
                self.failure_event(self.tap_failure['test'], 'Browser test failed; see full log', self.tap_failure['file'])
                self.tap_failure = None

    def checkout_changed(self, changed):
        if changed:
            guard = self.data['checkout']
            guard['status'] = 'FAIL'
            guard['changed_files'] = sorted(set(guard['changed_files']) | set(changed))
            self.output('Checkout changed during checks:\n' + ''.join('  ' + name + '\n' for name in changed))

    def flush_line(self):
        self.failure(self.pending_line)
        self.pending_line = ''

    def finish(self, results, exit_code, started):
        for name, status in results.items():
            self.data['suites'][name]['status'] = status
        self.data.update(exit_code=exit_code, duration_seconds=round(time.monotonic() - started, 2),
                         log=str(self.directory / 'output.log'))
        (self.directory / 'report.json').write_text(json.dumps(self.data, ensure_ascii=False, indent=2) + '\n')
        self.log.close()


def descendants(pid):
    # Browsers may start a new process group. Capture descendants before stopping
    # their parent, while their ownership can still be established by PPID.
    table = subprocess.check_output(['ps', '-axo', 'pid=,ppid='], text=True)
    children = [tuple(map(int, line.split())) for line in table.splitlines()]
    owned = {pid}
    while True:
        more = {child for child, parent in children if parent in owned}
        if more <= owned:
            return owned - {pid}
        owned.update(more)


def execute(command, env, report=None, **output):
    record = None
    if report and '-m' in command and 'pytest' in command:
        position = command.index('pytest') + 1
        command = [*command[:position], '-p', 'scripts.pytest_events', *command[position:]]
    if report and report.current:
        record = dict(command=[str(part) for part in command], exit_code=None)
        report.data['suites'][report.current]['commands'].append(record)
        report.write('$ ' + shlex.join(record['command']) + '\n')
    if report and not output:
        output = dict(stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    process = subprocess.Popen(command, cwd=ROOT, env=env, start_new_session=True, **output)
    decoder = codecs.getincrementaldecoder('utf-8')(errors='replace')
    eof = False
    def read_output(timeout):
        nonlocal eof
        ready, _, _ = select.select([process.stdout], [], [], timeout)
        if not ready:
            return False
        chunk = os.read(process.stdout.fileno(), 65536)
        if not chunk:
            eof = True
            return False
        report.output(decoder.decode(chunk))
        return True
    def finish_output():
        if report and process.stdout is not None:
            while read_output(0):
                pass
            report.output(decoder.decode(b'', final=True))
            if report.pending_line:
                report.output('\n')
            report.flush_line()
            process.stdout.close()
    try:
        if report and process.stdout is not None:
            while process.poll() is None and not eof:
                read_output(0.1)
        code = process.wait()
        if record is not None:
            record['exit_code'] = code
        return code
    finally:
        try:
            try:
                owned = descendants(process.pid)
            except (OSError, subprocess.SubprocessError):
                # Preserve process-group cleanup even if process inspection fails.
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
                raise
            def stop(sig):
                try:
                    os.killpg(process.pid, sig)
                except ProcessLookupError:
                    pass
                for pid in owned:
                    try:
                        os.kill(pid, sig)
                    except ProcessLookupError:
                        pass
            stop(signal.SIGTERM)
            deadline = time.monotonic() + 1
            while time.monotonic() < deadline:
                process.poll()
                alive = False
                for pid in owned | {process.pid}:
                    try:
                        os.kill(pid, 0)
                        alive = True
                    except ProcessLookupError:
                        pass
                if not alive:
                    break
                time.sleep(0.02)
            stop(signal.SIGKILL)
            process.wait()
        finally:
            finish_output()


def syntax_commands(node, paths):
    typed = [str(path) for path in paths if Path(path).suffix in ('.ts', '.tsx', '.cts', '.mts')]
    commands = [[node, '--require', 'tsx/cjs', str(ROOT / 'scripts/check-ts.cts'), *typed]] if typed else []
    return commands + [[node, '--check', str(path)] for path in paths if str(path) not in typed]


def executable(value, name):
    found = shutil.which(value)
    if not found:
        raise RuntimeError(f'{name} missing: {value}. See tests/browser/README.md for setup.')
    return found


def checkout_state(excluded):
    inventory = subprocess.check_output(['git', 'ls-files', '--cached', '--others', '--exclude-standard', '-z'], cwd=ROOT)
    result = {}
    for raw in inventory.split(b'\0'):
        if not raw:
            continue
        name = os.fsdecode(raw)
        path = ROOT / name
        if path.is_relative_to(excluded):
            continue
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            result[name] = None
            continue
        payload = os.fsencode(os.readlink(path)) if stat.S_ISLNK(metadata.st_mode) else path.read_bytes() if stat.S_ISREG(metadata.st_mode) else b''
        result[name] = (metadata.st_mode, hashlib.sha256(payload).hexdigest())
    return result


TOOL_TESTS = ('tests/development/test_update_checkout.py', 'tests/development/test_check_snapshot.py', 'tests/development/test_check_report.py', 'tests/development/test_prepare_worktree.py', 'tests/development/test_check_feedback.py', 'tests/development/test_api_generation.py', 'tests/development/test_browser_host.py', 'tests/development/test_build_speed.py', 'tests/development/test_check_runner.py', 'tests/development/test_frontend_builder.py', 'tests/development/test_github_issues.py', 'tests/development/test_hooks.py', 'tests/development/test_process_logs.py', 'tests/development/test_task_changes.py', 'tests/api/test_governance.py', 'tests/api/test_strict_generation.py')
TOOL_INPUTS = ('scripts/', '.githooks/', '.github/', 'api/', 'tests/development/',
               'tests/support/', 'frontend/src/api/generated/',
               'oko/reader/generated/',
               'tests/api/test_governance.py', 'tests/api/test_strict_generation.py',
               'package.json', 'package-lock.json', 'pyproject.toml', 'uv.lock',
               'tsconfig.json', 'tsconfig.browser-tests.json', 'tsconfig.tooling.json',
               'vite.config.mts', 'eslint.config.ts', '.gitignore', 'tests/process_server.py')


def tool_changes(root, base=None):
    """Compare branch + index + worktree, including new files; uncertainty runs tests."""
    def git(*args):
        try:
            return subprocess.run(['git', *args], cwd=root, capture_output=True, text=True)
        except OSError:
            return subprocess.CompletedProcess(['git', *args], 1, '', '')
    if base is None:
        reference = git('merge-base', 'HEAD', 'origin/main')
        if reference.returncode or not reference.stdout.strip():
            return True, ['<comparison unavailable>']
        base = reference.stdout.strip()
    changed = git('diff', '--no-renames', '--name-only', '-z', base, '--')
    staged = git('diff', '--cached', '--no-renames', '--name-only', '-z', base, '--')
    untracked = git('ls-files', '--others', '--exclude-standard', '-z')
    if changed.returncode or staged.returncode or untracked.returncode:
        return True, ['<comparison unavailable>']
    paths = sorted(set((changed.stdout + staged.stdout + untracked.stdout).split('\0')) - {''})
    relevant = [name for name in paths if any(name.startswith(prefix) if prefix.endswith('/') else name == prefix for prefix in TOOL_INPUTS)]
    return bool(relevant), relevant


def parallel_tests(names, commands, environment, report, results, match=None):
    """Fork isolated report owners; the parent owns cancellation and the checkout guard."""
    original_names = names
    commands = dict(commands)
    owners = {}
    jobs = []
    for name in names:
        command = commands[name][0]
        if name in ('python-tests', 'tool-tests'):
            specified = command[4:]
            ignored = {str((ROOT / value.split('=', 1)[1]).resolve()) for value in specified if value.startswith('--ignore=')}
            files = [value for value in specified if not value.startswith('--ignore=')]
            if not files:
                files = sorted(str(file) for file in (ROOT / 'tests').rglob('*.py')
                               if (file.name.startswith('test_') or file.name.endswith('_test.py'))
                               and str(file.resolve()) not in ignored)
            files = list(dict.fromkeys(files))
            if len(files) > 1 and all((ROOT / value.split('::')[0]).is_file() for value in files):
                # Spend extra workers on a standalone Python run, not on CPU
                # contention with browser/codegen processes in the full run.
                standalone_python = name == 'python-tests' and not {'browser', 'tool-tests'} & set(names)
                count = min(len(files), 4 if standalone_python else 2)
                buckets, weights = [[] for _ in range(count)], [0] * count
                def weight(value):
                    file = Path(value.split('::')[0])
                    return max(1, (file if file.is_absolute() else ROOT / file).stat().st_size)
                for value in sorted(dict.fromkeys(files), key=lambda value: (-weight(value), value)):
                    index = min(range(count), key=lambda i: weights[i])
                    buckets[index].append(value)
                    weights[index] += weight(value)
                for index, bucket in enumerate(buckets, 1):
                    job = name + '-' + str(index)
                    commands[job] = [[*command[:4], *bucket]]
                    owners[job] = name
                    jobs.append(job)
                continue
        owners[name] = name
        jobs.append(name)
    names = jobs
    baseline = checkout_state(report.directory)
    children = {}
    completed = {}
    interrupted = False
    event_offsets = {}
    event_pending = {}
    def relay_failures():
        for name in names:
            path = report.directory/(name+'-events.jsonl')
            if not path.exists():
                continue
            offset = event_offsets.get(name, 0)
            if path.stat().st_size == offset:
                continue
            with path.open('rb') as events:
                events.seek(offset)
                lines = (event_pending.get(name, b'')+events.read()).split(b'\n')
                event_offsets[name] = events.tell()
            event_pending[name] = lines.pop()
            for line in lines:
                report.announce_failure(json.loads(line))
    try:
        for name in names:
            report.output(f'\nRUN {name} (parallel)\n')
            result_file = report.directory / (name + '-result.json')
            pid = os.fork()
            if pid == 0:
                os.setsid()
                child_report = Report(report.directory / 'parallel' / name, [name], {})
                child_report.current = name
                child_report.events_file = report.directory/(name+'-events.jsonl')
                child_env = dict(environment, OKO_TEST_ARTIFACT_DIR=str(report.directory / 'artifacts' / name))
                Path(child_env['OKO_TEST_ARTIFACT_DIR']).mkdir(parents=True, exist_ok=True)
                tick = time.monotonic()
                code, status = 1, 'FAIL'
                # The parent replays each complete log; stdout from workers cannot interleave.
                with open(os.devnull, 'w') as sink:
                    sys.stdout = sys.stderr = sink
                    try:
                        code = 0
                        for command in commands[name]:
                            code = execute(command, child_env, report=child_report)
                            if code:
                                break
                        if name == 'browser' and match is not None and not child_report.data['suites'][name].get('passed_scenarios'):
                            child_report.output('No browser scenarios matched the requested filter.\n')
                            code = 1
                        status = f'{"FAIL" if code else "PASS"} ({time.monotonic() - tick:.2f}s)'
                    except KeyboardInterrupt:
                        code, status = 130, 'INTERRUPTED'
                    except BaseException as error:
                        code = 1
                        child_report.output(str(error) + '\n')
                    finally:
                        child_report.finish({name: status}, code, tick)
                        result_file.write_text(json.dumps({'report': str(child_report.directory / 'report.json')}))
                os._exit(code if 0 <= code <= 255 else 1)
            children[pid] = (name, result_file)
        while len(completed) < len(children):
            relay_failures()
            for pid in children.keys() - completed.keys():
                ended, status = os.waitpid(pid, os.WNOHANG)
                if ended:
                    completed[pid] = status
            if len(completed) < len(children):
                time.sleep(.02)
    except KeyboardInterrupt:
        interrupted = True
        raise
    finally:
        relay_failures()
        # Signal workers first: execute() in each worker owns and reaps its children.
        pending = children.keys() - completed.keys()
        owned = set()
        for pid in pending:
            try:
                owned.update(descendants(pid))
            except (OSError, subprocess.SubprocessError):
                pass  # Worker cleanup still runs; never skip signal/reap on ps failure.
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 5
        while pending and time.monotonic() < deadline:
            for pid in list(pending):
                ended, status = os.waitpid(pid, os.WNOHANG)
                if ended:
                    completed[pid] = status
                    pending.remove(pid)
            if pending:
                time.sleep(.02)
        for pid in pending:
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        for pid in pending | owned:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        for pid in pending:
            _, completed[pid] = os.waitpid(pid, 0)
        job_results = {}
        job_seconds = {}
        for pid, (name, result_file) in children.items():
            owner = owners[name]
            report.current = owner
            if result_file.exists():
                child = json.loads(Path(json.loads(result_file.read_text())['report']).read_text())
                report.output(Path(child['log']).read_text())
                data = child['suites'][name]
                job_seconds[name] = child['duration_seconds']
                if name == owner:
                    report.data['suites'][owner] = data
                else:
                    aggregate = report.data['suites'][owner]
                    aggregate['commands'].extend(data['commands'])
                    aggregate['failures'] = list(dict.fromkeys([*aggregate['failures'], *data['failures']]))
                    aggregate.setdefault('failure_details', []).extend(data.get('failure_details', []))
                    aggregate.setdefault('workers', {})[name] = data
                job_results[name] = data['status']
                if completed.get(pid) != 0 and job_results[name].startswith('PASS'):
                    job_results[name] = 'FAIL (worker exited abnormally)'
            else:
                job_results[name] = 'INTERRUPTED' if interrupted else 'FAIL (worker produced no report)'
        for owner in original_names:
            report.data['suites'][owner]['failures'] = list(dict.fromkeys(report.data['suites'][owner]['failures']))
            statuses = [status for name, status in job_results.items() if owners[name] == owner]
            results[owner] = (statuses[0] if len(statuses) == 1 else
                              f"PASS ({max(job_seconds[name] for name in job_seconds if owners[name] == owner):.2f}s)" if all(value.startswith('PASS') for value in statuses)
                              else next(value for value in statuses if not value.startswith('PASS')))
        after = checkout_state(report.directory)
        changed = sorted(name for name in baseline.keys() | after.keys() if baseline.get(name) != after.get(name))
        for name in original_names:
            report.data['suites'][name]['checkout_changes'] = changed
        report.checkout_changed(changed)



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    groups = {'ui': ['build', 'syntax', 'lint', 'http', 'browser', 'diff'],
              'all': ['contracts', 'build', 'syntax', 'lint', 'types', 'http', 'browser', 'diff', 'python-tests', 'entrypoint'],
              'python': ['contracts', 'python-tests'],
              'tools': ['contracts', 'tool-tests'],
              'lifecycle': ['build', 'syntax', 'lint', 'browser', 'diff']}
    suites = ('contracts', 'build', 'syntax', 'lint', 'http', 'browser', 'browser-types', 'tooling-types', 'diff', 'types', 'entrypoint', 'staged')
    parser.add_argument('sets', nargs='+', choices=(*groups, *suites))
    parser.add_argument('--match', help='Regex selecting browser scenarios by name (requires browser checks)')
    parser.add_argument('--files', nargs='+', help='Explicit browser/Python test files or JavaScript files for lint/syntax; put check sets before this option')
    parser.add_argument('--report-dir', type=Path, default=ROOT / '.scratch/check-runs', help='Parent directory for separate full logs and JSON reports for each run')
    parser.add_argument('--browser-workers', type=int, choices=(2, 4), default=4, help='Concurrent browser files (bounded to 2 or 4)')
    parser.add_argument('--tools-needed', action='store_true', help='Print tool-change selection and exit before setting up runtimes')
    parser.add_argument('--base', help='Git revision for tool-change selection; default: merge-base with origin/main')
    parser.add_argument('--if-changed', action='store_true', help='Run the explicit tools suite only when its inputs changed')
    parser.add_argument('--in-place', action='store_true', help='Check this checkout directly; local all otherwise uses a captured tree')
    parser.add_argument('--compact', action='store_true', help='Print the summary only; preserve full output in the report log')
    args = parser.parse_args()
    if args.if_changed and args.sets != ['tools']:
        parser.error('--if-changed requires the tools group alone')
    env = os.environ.copy()
    started = time.monotonic()
    names = list(dict.fromkeys(name for selected in args.sets for name in groups.get(selected, [selected])))
    tools_required, tool_inputs = tool_changes(ROOT, args.base)
    if args.tools_needed:
        print('true' if tools_required else 'false')
        return 0
    if 'all' in args.sets and tools_required and not args.files:
        if 'tool-tests' not in names:
            names.append('tool-tests')
    if args.if_changed and not tools_required:
        names.remove('tool-tests')
    if {'build','syntax','lint','browser'} & set(names) and 'tooling-types' not in names:
        names.insert(0, 'tooling-types')
    if 'browser' in names and 'browser-types' not in names:
        names.insert(names.index('browser'), 'browser-types')
    if {'browser', 'python-tests', 'tool-tests'} & set(names):
        early = [name for name in ['contracts','tooling-types','syntax','lint','types','browser-types','build','http'] if name in names]
        names = early + [name for name in names if name not in early]
    if args.match is not None and 'browser' not in names:
        parser.error('--match requires browser checks')
    selected_files = {'browser': [], 'python-tests': [], 'tool-tests': [], 'syntax': [], 'lint': []}
    for value in args.files or []:
        filename, *node_id = value.split('::', 1)
        candidate = (ROOT / filename).resolve()
        if not candidate.is_relative_to(ROOT) or not candidate.is_file():
            parser.error(f'Check file missing or outside checkout: {value}')
        relative = candidate.relative_to(ROOT)
        matched = False
        for name in names:
            browser = name == 'browser' and relative.parts[:2] == ('tests', 'browser') and candidate.name.startswith('test_') and candidate.suffix == '.ts' and not node_id
            python_test = name in ('python-tests', 'tool-tests') and relative.parts[0] == 'tests' and candidate.suffix == '.py'
            javascript = ((name in ('syntax', 'lint') and candidate.suffix in ('.js', '.cjs', '.mjs', '.ts', '.tsx', '.cts', '.mts')) or (name == 'syntax' and candidate.suffix in ('.ts', '.tsx'))) and not node_id
            if browser or python_test or javascript:
                selected_files[name].append(str(candidate) + ('::' + node_id[0] if node_id else ''))
                matched = True
        if not matched:
            parser.error(f'File does not match selected checks: {value}')
    if 'lifecycle' in args.sets and not {'ui','all','browser'} & set(args.sets) and not selected_files['browser']:
        selected_files['browser'] = [str(ROOT / 'tests/browser/test_ui_lifecycle.ts')]
    if 'all' in args.sets and not args.in_place and not os.environ.get('CI'):
        from check_snapshot import run
        from task_changes import TaskError
        # Rebuild paths relative to the source; absolute --files must refer to
        # their captured counterparts rather than the editable checkout.
        arguments = [*args.sets]
        for option, value in (('--match', args.match),):
            if value is not None:
                arguments.extend([option, value])
        if args.files:
            arguments.append('--files')
            for value in args.files:
                filename, *node_id = value.split('::', 1)
                relative = (ROOT / filename).resolve().relative_to(ROOT)
                arguments.append(str(relative) + ('::' + node_id[0] if node_id else ''))
        arguments.extend(['--browser-workers', str(args.browser_workers)])
        if args.compact:
            arguments.append('--compact')
        try:
            return run(ROOT, arguments, args.report_dir.resolve(), args.base)
        except (TaskError, OSError, ValueError) as error:
            print(str(error), file=sys.stderr)
            return 1
    report = Report(args.report_dir.resolve(), names, selected_files)
    report.compact = args.compact
    if os.environ.get('OKO_CHECK_SNAPSHOT'):
        report.data['snapshot'] = json.loads(os.environ['OKO_CHECK_SNAPSHOT'])
    report.data['browser_name_pattern'] = args.match
    report.data['tool_selection'] = dict(required=tools_required, inputs=tool_inputs, base=args.base)
    if ('all' in args.sets and not args.files) or args.if_changed:
        report.output('Tool tests: ' + ('selected' if tools_required else 'unchanged; not selected') + '\n')
    results = dict.fromkeys(names, 'NOT RUN')
    current = None
    exit_code = 1
    try:
        if os.name != 'posix':
            raise RuntimeError('This check runner requires a POSIX host (macOS or Linux).')
        node = executable(env.get('OKO_NODE', 'node'), 'Node') if {'build', 'syntax', 'lint', 'browser', 'browser-types', 'tooling-types'} & set(names) else None
        executable('git', 'Git')
        executable('ps', 'POSIX ps')
        descendants(os.getpid())  # Require process inspection before launching checks.
        if 'browser' in names:
            with tempfile.TemporaryFile(mode='w+') as output:
                probe_code = execute([node, '-e', '''
    if (Number(process.versions.node.split('.')[0]) < 20) throw new Error('Node >=20 required');
    const fs = require('node:fs');
    const {chromium} = require('playwright');
    require('playwright/test');
    const candidates = process.env.OKO_BROWSER_EXECUTABLE ? [process.env.OKO_BROWSER_EXECUTABLE] : [
     chromium.executablePath(), '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
     '/usr/bin/chromium', '/usr/bin/chromium-browser', '/usr/bin/google-chrome'];
    const browser = candidates.find(p => {try {fs.accessSync(p, fs.constants.X_OK); return true;} catch {return false;}});
    if (!browser) throw new Error('Chrome/Chromium missing; set OKO_BROWSER_EXECUTABLE');
    console.log(browser);
    '''], env, stdout=output, stderr=output)
                output.seek(0)
                probe_text = output.read()
                report.write(probe_text)
            if probe_code:
                raise RuntimeError('Browser dependencies unavailable. See tests/browser/README.md.\n' + probe_text)
            env['OKO_BROWSER_EXECUTABLE'] = probe_text.strip()
        commands = {
            'build': [[node, '--import', 'tsx', str(ROOT / 'scripts/build-frontend.mts')], [node, '--import', 'tsx', str(ROOT / 'scripts/build-frontend.mts'), '--check']],
            'syntax': syntax_commands(node, selected_files['syntax'] or sorted(path for path in (ROOT / 'frontend').rglob('*') if path.suffix in ('.js', '.mjs', '.ts', '.tsx'))),
            'lint': [[node, '--require', 'tsx/cjs', str(ROOT / 'scripts/lint-js.cts'), *dict.fromkeys(selected_files['lint'])]],
            'tooling-types': [[node, '--import', 'tsx', str(ROOT / 'scripts/check-types.mts'), 'tsconfig.tooling.json']],
            'browser-types': [[node, '--import', 'tsx', str(ROOT / 'scripts/check-types.mts'), 'tsconfig.browser-tests.json']],
            'browser': [[node, '--require', 'tsx/cjs', '--require', str(ROOT / 'scripts/register-browser-typescript.cts'), '--enable-source-maps', '--test', '--test-concurrency=' + str(args.browser_workers), *(['--test-name-pattern=' + args.match] if args.match is not None else []), *dict.fromkeys(selected_files['browser'] or map(str, sorted((ROOT / 'tests/browser').glob('test_*.ts'))))]],
            'diff': [['git', 'diff', '--check'], ['git', 'diff', '--cached', '--check']],
        }
        if {'contracts', 'http', 'python-tests', 'tool-tests', 'types', 'entrypoint', 'staged', 'browser'} & set(names):
            default_python = str(ROOT / '.venv/bin/python') if (ROOT / '.venv/bin/python').exists() else 'python3'
            python = executable(env.get('OKO_PYTHON', default_python), 'Python')
            env['OKO_PYTHON'] = python
            commands.update({'contracts': [[python, str(ROOT / 'scripts/check_test_contracts.py')]], 'http': [[python, '-m', 'pytest', '-q', 'tests/reader/test_web_assets.py', 'tests/reader/test_frontend_delivery.py', 'tests/reader/test_frontend_build.py', 'tests/reader/test_http_contracts.py']],
                             'staged': [[python, str(ROOT / 'scripts/check-staged')]],
                             'python-tests': [[python, '-m', 'pytest', '-q', *dict.fromkeys(selected_files['python-tests'])]],
                             'tool-tests': [[python, '-m', 'pytest', '-q', *dict.fromkeys(selected_files['tool-tests'] or TOOL_TESTS)]],
                             'types': [[python, '-m', 'mypy', 'oko', 'tests/support/codex.py', 'tests/support/app.py']],
                             'entrypoint': [[python, '-m', 'oko', '--help']]})
        if ('syntax' in names and not commands['syntax']) or ('browser' in names and not list((ROOT / 'tests/browser').glob('test_*.ts'))):
            raise RuntimeError('Required UI modules or browser tests are missing.')
        if 'python-tests' in commands and not selected_files['python-tests']:
            commands['python-tests'][0].extend('--ignore=' + name for name in TOOL_TESTS)
            if 'http' in names:
                commands['python-tests'][0].extend('--ignore=' + name for name in commands['http'][0][4:])
        def blocked(name):
            return (any(results.get(gate, '').startswith('FAIL') for gate in ('tooling-types', 'build', 'types'))
                    or (name == 'browser' and any(results.get(gate, '').startswith('FAIL') for gate in ('syntax', 'lint', 'browser-types'))))
        for current in names:
            if results[current] != 'NOT RUN':
                continue
            if current in ('browser', 'python-tests', 'tool-tests'):
                runnable = [name for name in names if name in ('browser', 'python-tests', 'tool-tests') and results[name] == 'NOT RUN' and not blocked(name)]
                if len(runnable) > 1 or current in ('python-tests', 'tool-tests'):
                    parallel_tests(runnable, commands, env, report, results, args.match)
                    if results[current] != 'NOT RUN':
                        continue
                if blocked(current):
                    report.output(f'{current} skipped because a prerequisite failed.\n')
                    continue
            if current in ('build','syntax','lint','http','browser','python-tests') and results.get('tooling-types', '').startswith('FAIL'):
                report.output(f'{current} skipped because tooling types failed.\n')
                continue
            if current in ('browser', 'http', 'python-tests') and results.get('build', '').startswith('FAIL'):
                report.output(f'{current} skipped because build failed.\n')
                continue
            if current in ('browser', 'python-tests') and results.get('types', '').startswith('FAIL'):
                report.output(f'{current} skipped because types failed.\n')
                continue
            if current == 'browser' and any(results.get(name, '').startswith('FAIL') for name in ['syntax','lint','browser-types']):
                report.output('Browser skipped because syntax, lint or browser types failed.\n')
                continue
            report.current = current
            report.output(f'\nRUN {current}\n')
            tick = time.monotonic()
            baseline = None
            if current in ['browser','python-tests','tool-tests']:
                artifact_dir = report.directory / 'artifacts' / current
                artifact_dir.mkdir(parents=True, exist_ok=True)
                env['OKO_TEST_ARTIFACT_DIR'] = str(artifact_dir)
                baseline = checkout_state(report.directory)
            for command in commands[current]:
                if execute(command, env, report=report):
                    results[current] = f'FAIL ({time.monotonic() - tick:.2f}s)'
                    break
            else:
                if current == 'browser' and args.match is not None and not report.data['suites']['browser'].get('passed_scenarios'):
                    report.output('No browser scenarios matched the requested filter.\n')
                    results[current] = f'FAIL ({time.monotonic() - tick:.2f}s)'
                else:
                    results[current] = f'PASS ({time.monotonic() - tick:.2f}s)'
            if baseline is not None:
                after = checkout_state(report.directory)
                changed = sorted(name for name in baseline.keys() | after.keys() if baseline.get(name) != after.get(name))
                report.data['suites'][current]['checkout_changes'] = changed
                report.checkout_changed(changed)
        exit_code = int(report.data['checkout']['status'] != 'PASS' or any(not value.startswith('PASS') for value in results.values()))
    except KeyboardInterrupt:
        if current and results[current] == 'NOT RUN':
            results[current] = 'INTERRUPTED'
        report.output('\nInterrupted\n', stream=sys.stderr)
        exit_code = 130
    except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:
        if current:
            results[current] = 'FAIL'
        report.output(str(error) + '\n', stream=sys.stderr)
    finally:
        report.current = None
        report.compact = False
        report.output('\nCheck summary\n')
        for name, status in results.items():
            state, *detail = status.split(' ', 1)
            if status == 'NOT RUN':
                report.output(f'NOT RUN {name}\n')
            else:
                report.output(f'{state} {name} {" ".join(detail)}'.rstrip() + '\n')
        if report.data['checkout']['status'] != 'PASS':
            report.output('FAIL checkout_changed: ' + ', '.join(report.data['checkout']['changed_files']) + '\n')
        for name, suite in report.data['suites'].items():
            for failure in suite['failures']:
                report.output(f'  {name}: {failure}\n')
        report.output(f'Total {time.monotonic() - started:.2f}s\n')
        report.output(f'Report: {report.directory / "report.json"}\n')
        report.finish(results, exit_code, started)
    return exit_code


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    sys.exit(main())
