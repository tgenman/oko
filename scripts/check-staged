#!/usr/bin/env python3
"""Check exact staged Python/JavaScript/TypeScript bytes, including partial staging."""
import os
import json
from pathlib import Path
import shutil
import subprocess
import sys
import staged_cache


def main():
    failed = subprocess.run(['git', 'diff', '--cached', '--check']).returncode != 0
    names = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z'])
    changed = [os.fsdecode(name) for name in subprocess.check_output(
        ['git', 'diff', '--cached', '--name-only', '--no-renames', '-z']).split(b'\0') if name]
    relevant = any(name.endswith(('.py', '.js', '.mjs', '.cjs', '.ts', '.tsx', '.cts', '.mts', '.json'))
                   or name.startswith(('scripts/', 'api/')) or name in
                   ('package.json', 'package-lock.json', 'pyproject.toml', 'uv.lock',
                    'tsconfig.json', 'tsconfig.tooling.json', 'tsconfig.browser-tests.json')
                   for name in changed)
    if not relevant:
        return int(failed)
    receipt = staged_cache.key()
    if not failed and staged_cache.hit(receipt):
        print('Staged checks cache hit (exact Git index, HEAD, checkers and tools)')
        return 0
    typed_inputs = []
    for raw in names.split(b'\0'):
        if not raw:
            continue
        name = os.fsdecode(raw)
        python = name.endswith('.py') or name in ('scripts/check', 'scripts/check-staged')
        javascript = name.endswith(('.js', '.mjs', '.cjs'))
        typescript = name.endswith(('.ts', '.tsx', '.cts', '.mts'))
        if not (python or javascript or typescript):
            continue
        content = subprocess.check_output(['git', 'show', ':' + name])
        if python:
            try:
                compile(content, name, 'exec')
            except (SyntaxError, ValueError) as error:
                print(f'{name}: {error}', file=sys.stderr)
                failed = True
        else:
            node = shutil.which(os.environ.get('OKO_NODE', 'node'))
            if not node:
                print('Node missing; set OKO_NODE or install Node 26.12.0+.', file=sys.stderr)
                return 1
            print(f'CHECK staged {name}', flush=True)
            if typescript:
                typed_inputs.append(dict(name=name, source=content.decode('utf-8')))
                continue
            mode = 'commonjs' if name.endswith('.cjs') else 'module'
            if subprocess.run([node, '--check', '--input-type=' + mode], input=content).returncode:
                failed = True
            elif subprocess.run([node, '--require', 'tsx/cjs', str(Path(__file__).with_name('lint-js.cts')), '--stdin', name], input=content).returncode:
                failed = True
    if typed_inputs:
        if subprocess.run([node, '--require', 'tsx/cjs', str(Path(__file__).with_name('check-ts.cts')), '--stdin-files'],
                          input=json.dumps(typed_inputs).encode('utf-8')).returncode:
            failed = True
    if any(name.startswith('tests/') and name.endswith('.py') or name in ('oko/processing/codex.py', 'scripts/check_test_contracts.py') for name in changed):
        failed = subprocess.run([sys.executable, str(Path(__file__).with_name('check_test_contracts.py')), '--staged']).returncode != 0 or failed
    failed = subprocess.run([sys.executable, str(Path(__file__).with_name('check-api-staged.py'))]).returncode != 0 or failed
    if any(name.endswith(('.ts', '.tsx', '.cts', '.mts', '.json')) for name in changed):
        node = shutil.which(os.environ.get('OKO_NODE', 'node'))
        if not node:
            print('Node missing for staged browser type checking.', file=sys.stderr)
            return 1
        failed = subprocess.run([node, '--require', 'tsx/cjs', str(Path(__file__).with_name('check-browser-types.cts'))]).returncode != 0 or failed
    if not failed:
        if receipt != staged_cache.key():
            print('Git index or checking inputs changed during pre-commit', file=sys.stderr)
            return 1
        staged_cache.remember(receipt)
    return int(failed)


if __name__ == '__main__':
    sys.exit(main())
