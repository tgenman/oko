#!/usr/bin/env python3
"""Check exact staged Python/JavaScript/TypeScript bytes, including partial staging."""
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    failed = subprocess.run(['git', 'diff', '--cached', '--check']).returncode != 0
    names = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z'])
    for raw in names.split(b'\0'):
        if not raw:
            continue
        name = os.fsdecode(raw)
        python = name.endswith('.py') or name in ('scripts/check', 'scripts/check-staged')
        javascript = name.endswith(('.js', '.mjs', '.cjs'))
        typescript = name.endswith(('.ts', '.tsx'))
        if not (python or javascript or typescript):
            continue
        content = subprocess.check_output(['git', 'show', ':' + name])
        if python:
            try:
                compile(content, name, 'exec')
            except (SyntaxError, ValueError) as error:
                print(f'{name}: {error}', file=sys.stderr)
                failed = True
        else:
            node = shutil.which(os.environ.get('OKO_NODE', 'node'))
            if not node:
                print('Node missing; set OKO_NODE or install Node >=20.', file=sys.stderr)
                return 1
            print(f'CHECK staged {name}', flush=True)
            if typescript:
                if subprocess.run([node, str(Path(__file__).with_name('check-ts.cjs')), '--stdin', name], input=content).returncode:
                    failed = True
                continue
            mode = 'commonjs' if name.endswith('.cjs') else 'module'
            if subprocess.run([node, '--check', '--input-type=' + mode], input=content).returncode:
                failed = True
            elif subprocess.run([node, str(Path(__file__).with_name('lint-js.cjs')), '--stdin', name], input=content).returncode:
                failed = True
    failed = subprocess.run([sys.executable, str(Path(__file__).with_name('check_test_contracts.py')), '--staged']).returncode != 0 or failed
    failed = subprocess.run([sys.executable, str(Path(__file__).with_name('check-api-staged.py'))]).returncode != 0 or failed
    if any(os.fsdecode(name).endswith(('.ts', '.tsx')) or os.fsdecode(name) in ('tsconfig.browser-tests.json', 'package.json', 'package-lock.json') for name in names.split(b'\0') if name):
        node = shutil.which(os.environ.get('OKO_NODE', 'node'))
        if not node:
            print('Node missing for staged browser type checking.', file=sys.stderr)
            return 1
        failed = subprocess.run([node, str(Path(__file__).with_name('check-browser-types.cjs'))]).returncode != 0 or failed
    return int(failed)


if __name__ == '__main__':
    sys.exit(main())
