#!/usr/bin/env python3
"""Manage shared-reader credentials locally; never print passwords or store plaintext in data."""
import argparse
import getpass
import os
from pathlib import Path
import secrets
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from oko.reader.password_auth import PasswordAccess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--data', type=Path, default=Path.home() / 'Library/Application Support/Oko/data')
    parser.add_argument('operation', choices=['set', 'disable', 'list', 'origin'])
    parser.add_argument('login', nargs='?')
    parser.add_argument('--generate-to', type=Path, help='Create a private NEW file containing the generated password')
    args = parser.parse_args()
    access = PasswordAccess(args.data)
    if args.operation == 'list':
        with access.state() as state:
            print('\n'.join(sorted(state['users'])))
        return
    if not args.login:
        parser.error('login is required')
    if args.operation == 'origin':
        from urllib.parse import urlsplit
        parsed = urlsplit(args.login)
        if parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password or parsed.path not in ('', '/') or parsed.query or parsed.fragment:
            parser.error('Expected a single HTTPS origin without path')
        with access.state(write=True) as state:
            state['origin'] = args.login.rstrip('/')
        print('HTTPS origin saved. Restart the reader to apply.')
        return
    if args.operation == 'disable':
        if args.generate_to:
            parser.error('--generate-to is only for set')
        access.set_user(args.login, None)
    else:
        password = secrets.token_urlsafe(24) if args.generate_to else getpass.getpass('Password: ')
        if not args.generate_to and password != getpass.getpass('Repeat password: '):
            parser.error('Passwords differ')
        if args.generate_to:
            # Exclusive create prevents clobbering a previous credential.
            fd = os.open(args.generate_to, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, 'w') as stream:
                stream.write(password + '\n')
        access.set_user(args.login, password)
    print('Access updated; previous sessions for this login were revoked.')


if __name__ == '__main__':
    main()
