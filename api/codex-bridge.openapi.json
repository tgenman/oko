  "components": {
    "schemas": {
      "CodexChoice": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$",
            "title": "Model",
            "type": "string"
          },
          "reasoning_effort": {
            "maxLength": 30,
            "minLength": 1,
            "pattern": "^[a-z_]+$",
            "title": "Reasoning Effort",
            "type": "string"
          },
          "fast": {
            "default": false,
            "title": "Fast",
            "type": "boolean"
          }
        },
        "required": [
          "model",
          "reasoning_effort"
        ],
        "title": "CodexChoice",
        "type": "object"
      },
      "JobRequest": {
        "additionalProperties": false,
        "properties": {
          "boot_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Boot Id",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Session Id",
            "type": "string"
          },
          "operation": {
            "enum": [
              "check",
              "catalog",
              "complete"
            ],
            "title": "Operation",
            "type": "string"
          },
          "prompt": {
            "default": "",
            "maxLength": 1048576,
            "title": "Prompt",
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "title": "Schema",
            "type": "object"
          },
          "choice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CodexChoice"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "deadline": {
            "title": "Deadline",
            "type": "number"
          }
        },
        "required": [
          "boot_id",
          "session_id",
          "operation",
          "deadline"
        ],
        "title": "JobRequest",
        "type": "object"
      }
    },
