{
  "openapi": "3.1.0",
  "info": {
    "title": "Oko private Codex bridge",
    "version": "1",
    "description": "Private loopback service. Reject every Origin header. X-Oko-Protocol: 1 and a bearer secret are mandatory on all operations. Request UTF-8 JSON <=1048576 bytes; result JSON <=1048576 bytes. One slot, no persistent queue. IDs and session IDs are 32 lowercase hex characters. Renew every 5s; ownership expires permanently after 20s or absolute deadline (maximum 180s). Retain content-free tombstones 600s, maximum 4096. Never recreate an unknown attempt after uncertain create; query the same boot/ID only. DELETE stops owned subprocesses and releases content; running means cleanup is still pending. JSON Schema is Draft 2020-12, self-contained fragment references only, nesting <=48 and structural nodes <=65536."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health V1 Health Get"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer token"
          },
          "403": {
            "description": "Browser Origin or foreign session"
          },
          "409": {
            "description": "Protocol, boot or identity conflict; busy or expired"
          },
          "413": {
            "description": "Request exceeds byte limit"
          },
          "422": {
            "description": "Invalid strict request"
          },
          "429": {
            "description": "Tombstone capacity reached"
          },
          "503": {
            "description": "Supervisor recovery required"
          }
        },
        "parameters": [
          {
            "name": "X-Oko-Protocol",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ]
      }
    },
