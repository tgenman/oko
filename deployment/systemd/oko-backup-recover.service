[Unit]
Description=Recover original Oko service intent after interrupted backup
After=docker.service
Wants=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/oko/config/backup.py recover
Restart=on-failure
RestartSec=10s
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/oko
[Install]
WantedBy=multi-user.target
