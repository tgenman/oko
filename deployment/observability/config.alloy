logging {
  level = "warn"
}

discovery.file "docker" {
  files = ["/etc/alloy-targets/docker.json"]
  refresh_interval = "5s"
}

loki.source.file "docker" {
  targets = discovery.file.docker.targets
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
  stage.docker {}
  forward_to = [loki.process.metadata.receiver]
}

loki.source.journal "codex" {
  path = "/var/log/journal"
  matches = "_SYSTEMD_UNIT=oko-codex.service"
  max_age = "168h"
  labels = { deployment = "oko", service = "codex", level = "info" }
  forward_to = [loki.process.metadata.receiver]
}

loki.process "metadata" {
  stage.match {
    selector = "{service=\"postgres\"}"
    stage.regex {
      expression = "(?P<pg_level>LOG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC):\\s+(?P<pg_message>.*)"
    }
    stage.template {
      source = "level"
      template = "{{ if .pg_level }}{{ ToLower .pg_level }}{{ else }}info{{ end }}"
    }
    // PostgreSQL exception messages can interpolate stored values. Central logs
    // retain severity, never the SQL statement, parameters, DETAIL or message.
    stage.template {
      source = "pg_safe"
      template = "postgresql_event"
    }
    stage.output { source = "pg_safe" }
  }
  stage.json { expressions = { level = "level" } }
  stage.labels { values = { level = "" } }
  stage.match {
    selector = "{level!~\"debug|info|warn|warning|error|fatal|panic|log|notice\"}"
    stage.static_labels { values = { level = "info" } }
  }
  // IDs and file paths are fields for queries, never stream labels.
  stage.label_drop { values = ["filename", "container_id", "job_id", "operation_id"] }
  stage.label_keep { values = ["deployment", "service", "level"] }
  forward_to = [otelcol.receiver.loki.logs.receiver]
}

// Persist each request before batching; no volatile processor.batch before disk.
otelcol.receiver.loki "logs" {
  output { logs = [otelcol.processor.groupbyattrs.labels.input] }
}
otelcol.processor.groupbyattrs "labels" {
  keys = ["deployment", "service", "level"]
  output { logs = [otelcol.exporter.otlphttp.logs.input] }
}
otelcol.storage.file "queue" {
  directory = "/var/lib/alloy/otel-queue"
  fsync = true
}
otelcol.exporter.otlphttp "logs" {
  client { endpoint = "http://loki:3100/otlp" }
  retry_on_failure {
    initial_interval = "500ms"
    max_interval = "5s"
    max_elapsed_time = "0s"
  }
  sending_queue {
    enabled = true
    num_consumers = 1
    queue_size = 200000
    sizer = "items"
    block_on_overflow = true
    storage = otelcol.storage.file.queue.handler
    batch {
      min_size = 200
      max_size = 500
      flush_timeout = "200ms"
    }
  }
}
