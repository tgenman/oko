{
  "name": "oko-browser-checks",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "swagger-ui-dist": "5.33.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "dev": "node scripts/build-frontend.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser-tests.json",
    "build:check": "node scripts/build-frontend.mjs --check",
    "api:generate": "node scripts/generate-api.mjs generate",
    "api:check": "node scripts/generate-api.mjs check",
    "api:compat": "node scripts/generate-api.mjs compat",
    "api:baseline": "node scripts/generate-api.mjs baseline",
    "api:lint": "node scripts/generate-api.mjs validate",
    "api:docs": "node scripts/generate-api.mjs docs",
    "typecheck:browser": "tsc -p tsconfig.browser-tests.json"
  }
}
