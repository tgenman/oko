{
  "name": "oko-browser-checks",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "playwright": "1.62.1",
    "swagger-ui-dist": "5.33.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-frontend.mts",
    "dev": "node --import tsx scripts/build-frontend.mts --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser-tests.json && tsc -p tsconfig.tooling.json",
    "build:check": "node --import tsx scripts/build-frontend.mts --check",
    "api:generate": "node --import tsx scripts/generate-api.mts generate",
    "api:check": "node --import tsx scripts/generate-api.mts check",
    "api:lint": "node --import tsx scripts/generate-api.mts validate",
    "api:docs": "node --import tsx scripts/generate-api.mts docs",
    "typecheck:browser": "tsc -p tsconfig.browser-tests.json",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "prototype:news-menu": "vite --config frontend/src/reading/news-menu.prototype.config.ts"
  }
}
