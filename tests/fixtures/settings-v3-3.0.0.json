              "$ref": "#/components/schemas/EffectiveOriginals"
            },
            "theses": {
              "$ref": "#/components/schemas/EffectiveTheses"
            },
            "prompt_theses": {
              "$ref": "#/components/schemas/EffectivePromptTheses"
            },
            "prompt_filters": {
              "$ref": "#/components/schemas/EffectivePromptFilters"
            },
            "processor": {
              "$ref": "#/components/schemas/EffectiveProcessor"
            }
          },
          "required": [
            "originals",
            "theses",
            "prompt_theses",
            "prompt_filters",
            "processor"
          ],
          "additionalProperties": false
